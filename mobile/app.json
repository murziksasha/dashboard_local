{
  "expo": {
    "name": "Dashboard Local",
    "slug": "dashboard-local",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0284c7"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "local.dashboard.app",
      "infoPlist": {
        "UIBackgroundModes": ["remote-notification"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0284c7"
      },
      "package": "local.dashboard.app",
      "permissions": ["NOTIFICATIONS"]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#0284c7"
        }
      ],
      "expo-document-picker"
    ],
    "extra": {
      "apiUrl": "http://10.0.2.2:3000"
    }
  }
}
